@@ -0,0 +1,24 @@
+package service_test
+
+// Two batches sharing a started_at to the microsecond, which is what opening them in one
+// transaction does. Without a tiebreaker the two listings disagree and this fails.
+func TestListBatchesIsATotalOrder(t *testing.T) {
+	ctx, pool, project := setup(t)
+
+	if _, err := pool.Exec(ctx, `INSERT INTO batches (project_id, kind, actor, started_at)
+		SELECT $1, 'plan', 'tester', now() FROM generate_series(1, 8)`, project.ID); err != nil {
+		t.Fatal(err)
+	}
+
+	first, err := service.ListBatches(ctx, pool, project.ID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 5; i++ {
+		again, err := service.ListBatches(ctx, pool, project.ID)
+		if err != nil {
+			t.Fatal(err)
+		}
+		for j := range first {
+			if first[j].ID != again[j].ID {
+				t.Fatalf("listing %d differs at %d: %s then %s", i, j, first[j].ID, again[j].ID)
+			}
+		}
+	}
+}
